# Caddy reverse proxy for api.stealthscraper.dev.
#
# Caddy handles TLS termination + Let's Encrypt cert auto-renewal so we
# never have to think about HTTPS again. It listens on 80/443 and forwards
# matching requests to the backend container at 127.0.0.1:7860.
#
# Reloaded after edits with:  sudo systemctl reload caddy
# Validated with:              sudo caddy validate --config /etc/caddy/Caddyfile

# Global options
{
  # Operator email for Let's Encrypt account + renewal reminders.
  email rushikesh.koochana@gmail.com
  # Sane defaults; Caddy 2 already does HSTS, OCSP stapling, HTTP/2 etc.
}

api.stealthscraper.dev {
  # Forward everything to the backend container.
  reverse_proxy 127.0.0.1:7860 {
    # Don't let a slow backend hold the public socket forever.
    transport http {
      read_timeout  90s
      write_timeout 90s
      dial_timeout  10s
    }
    # Pass real client IP / scheme so the backend's rate-limiting and
    # logging see the original request.
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }

  # CORS — the frontend on Vercel hits us cross-origin. The backend
  # already sets these headers in FastAPI middleware, so Caddy doesn't
  # need to. Left here for reference if we ever serve a non-Vercel
  # frontend that needs preflight from this layer.

  # Logging — structured JSON to journald (visible via journalctl -u caddy).
  log {
    output stdout
    format json
    level INFO
  }

  # Security headers — Caddy 2 has good defaults, but adding HSTS
  # explicitly so it's visible / auditable. 1 year + includeSubDomains.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Optional, post-launch: tighter CSP. For now leave open since the
    # backend serves no HTML.
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    # Don't leak our version
    -Server
  }

  # Compress JSON responses — backend already gzips screenshots but
  # JSON responses save another ~70% on the wire.
  encode zstd gzip
}

# If someone hits the bare IP or wrong domain, refuse politely.
:80, :443 {
  respond "Not found" 404 {
    close
  }
}
