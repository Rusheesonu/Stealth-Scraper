# Production env for the backend container on AWS Lightsail.
#
# Copy this file to /opt/stealth-scraper/.env.production and fill in
# every value. The compose file references them with ${VAR} syntax.
#
# CRITICAL: this file is gitignored and lives ONLY on the production
# server. Never commit it. Never paste it in chat/Slack/email.

# ── Supabase auth ────────────────────────────────────────────────────────
# Backend verifies user JWTs via the project's JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# ── Postgres (Supabase Session Pooler URL) ───────────────────────────────
# Same DATABASE_URL you had on HF Spaces secrets.
# Format: postgresql://postgres.<project>:<pwd>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Remember: any @ in the password must be %40 encoded.
DATABASE_URL=postgresql://postgres.xxxx:xxxxx@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ── Lemon Squeezy billing ────────────────────────────────────────────────
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_URL=https://stealthscraper.lemonsqueezy.com
# Plan variant IDs from your LS dashboard
LS_VARIANT_HOBBY=
LS_VARIANT_PRO=
LS_VARIANT_BUSINESS=

# ── LLM (AI extract) ─────────────────────────────────────────────────────
# Default provider is Groq (console.groq.com). Same key you had on HF.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Override the default model chain if you want to pin specific models.
# Leave commented for the default chain (llama-3.3-70b + llama-3.1-8b).
# LLM_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# ── Outbound webhook signing ─────────────────────────────────────────────
# Used to HMAC-sign payloads we POST to user-supplied webhook URLs from
# scheduled scrapes. 64-char hex from `openssl rand -hex 32`.
WEBHOOK_HMAC_SECRET=

# ── Residential proxies (opt-in) ─────────────────────────────────────────
# Leave false unless you've wired up backend/data/proxies.json with a
# working credential set. Enabled=true silently breaks if the file is
# missing — known pitfall.
PROXIES_ENABLED=false
