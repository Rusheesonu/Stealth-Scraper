# Copy to backend/.env. Gitignored.
# Backend verifies Supabase user JWTs via the project's JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co

# Lemon Squeezy billing
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_URL=https://yourstore.lemonsqueezy.com

LS_VARIANT_HOBBY=
LS_VARIANT_PRO=
LS_VARIANT_BUSINESS=

# Admin allowlist (csv emails) — these accounts get the unlimited "admin"
# plan + bypass the public-endpoint IP rate limit. Founder + trusted
# launch testers only; not on the public pricing page.
ADMIN_EMAILS=
