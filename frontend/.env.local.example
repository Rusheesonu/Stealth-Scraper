# Copy to .env.local. Where the Next.js app reaches the FastAPI backend.
BACKEND_URL=http://localhost:8000

# Supabase project credentials (dashboard → Settings → API).
# NEXT_PUBLIC_ prefix exposes to client; anon/publishable keys are designed for public use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
